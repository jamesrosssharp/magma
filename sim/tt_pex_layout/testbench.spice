.control
*  set filetype=ascii 
  setseed  8
  reset
  let run = 1
  save all
  op
  write ${RAW_FILE}
  reset
  set appendwrite
  dowhile run < = 5
    save vdd i(vvdd) temperat clk INP INN OUT0 OUT1 OUT2 OUT3 OUT4 OUT5 OUT6 OUT7 OUT8 OUT9
    *save all
    tran 2n 5u uic
    write ${RAW_FILE}
    let run = run + 1
    reset
  end
  quit 0
.endc

.end
